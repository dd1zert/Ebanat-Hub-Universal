local function createToggleButton(name, label, yPos, toggleFunc, hasMenu)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    btn.Text = label .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextScaled = true
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(100, 100, 150)
    btn.Parent = buttonContainer
    
    local state = false
    
    if hasMenu then
        local dots = Instance.new("TextLabel")
        dots.Size = UDim2.new(0, 20, 1, 0)
        dots.Position = UDim2.new(1, -25, 0, 0)
        dots.BackgroundTransparency = 1
        dots.Text = "…"
        dots.TextColor3 = Color3.fromRGB(180, 140, 255)
        dots.TextScaled = true
        dots.Font = Enum.Font.GothamBold
        dots.TextXAlignment = Enum.TextXAlignment.Center
        dots.Parent = btn
        
        btn.MouseButton2Click:Connect(function()
            createSpeedController()
        end)
    end
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        toggleFunc()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
            btn.Text = label .. " : ON"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            btn.Text = label .. " : OFF"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
    return btn
end

