function togglePush()
    pushEnabled = not pushEnabled
    
    if pushEnabled then
        createPlayerSelector()
        
        if pushConnection then pushConnection:Disconnect() end
        pushConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not pushEnabled or not pushTarget or not pushTarget.Character then return end
            local targetRoot = pushTarget.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end
            
            local c, h, r = getCharacter()
            if not c or not h or not r then return end
            
            local angle = tick() * PUSH_ROTATION_SPEED
            local radius = 10
            local x = targetRoot.Position.X + math.cos(angle) * radius
            local z = targetRoot.Position.Z + math.sin(angle) * radius
            local y = targetRoot.Position.Y + 5
            
            r.CFrame = CFrame.new(Vector3.new(x, y, z), targetRoot.Position)
            
            local pushVelocity = Instance.new("BodyVelocity")
            pushVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            local dir = (targetRoot.Position - r.Position).Unit
            pushVelocity.Velocity = dir * PUSH_FORCE + Vector3.new(0, PUSH_FORCE * 0.3, 0)
            pushVelocity.Parent = targetRoot
            
            task.wait(0.1)
            pushVelocity:Destroy()
        end)
    else
        if pushConnection then pushConnection:Disconnect(); pushConnection = nil end
        pushTarget = nil
    end
end

