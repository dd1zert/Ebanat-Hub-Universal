local function getCharacter()
    local char = player.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChild("Humanoid")
    local r = char:FindFirstChild("HumanoidRootPart")
    if not hum or not r then return nil, nil, nil end
    return char, hum, r
end

local function applyNoclipToAllParts(state)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

local function startNoclipLoop()
    if noclipConnections.heartbeat then noclipConnections.heartbeat:Disconnect() end
    if noclipConnections.renderstep then noclipConnections.renderstep:Disconnect() end
    if noclipConnections.stepped then noclipConnections.stepped:Disconnect() end
    
    noclipConnections.heartbeat = game:GetService("RunService").Heartbeat:Connect(function()
        if noclipEnabled then
            applyNoclipToAllParts(true)
        end
    end)
    
    noclipConnections.renderstep = game:GetService("RunService").RenderStepped:Connect(function()
        if noclipEnabled then
            applyNoclipToAllParts(true)
        end
    end)
    
    noclipConnections.stepped = game:GetService("RunService").Stepped:Connect(function()
        if noclipEnabled then
            applyNoclipToAllParts(true)
        end
    end)
end

local function stopNoclipLoop()
    if noclipConnections.heartbeat then noclipConnections.heartbeat:Disconnect(); noclipConnections.heartbeat = nil end
    if noclipConnections.renderstep then noclipConnections.renderstep:Disconnect(); noclipConnections.renderstep = nil end
    if noclipConnections.stepped then noclipConnections.stepped:Disconnect(); noclipConnections.stepped = nil end
end

function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        applyNoclipToAllParts(true)
        startNoclipLoop()
        player.CharacterAdded:Connect(function()
            if noclipEnabled then
                applyNoclipToAllParts(true)
            end
        end)
    else
        stopNoclipLoop()
        applyNoclipToAllParts(false)
    end
end

function toggleFly()
    flyEnabled = not flyEnabled
    local char, hum, r = getCharacter()
    if not char or not hum or not r then return end
    
    if flyEnabled then
        if not noclipEnabled then
            noclipEnabled = true
            applyNoclipToAllParts(true)
            startNoclipLoop()
        end
        
        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        flyBodyVelocity.Parent = r

        flyGyro = Instance.new("BodyGyro")
        flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyGyro.Parent = r

        hum.PlatformStand = true

        if flyConnection then flyConnection:Disconnect() end
        flyConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if not flyEnabled then return end
            local c, h, rt = getCharacter()
            if not c or not h or not rt then return end
            
            if noclipEnabled then
                applyNoclipToAllParts(true)
            end

            local move = Vector3.new()
            local camCFrame = camera.CFrame
            local forward = camCFrame.LookVector
            local right = camCFrame.RightVector
            local up = Vector3.new(0, 1, 0)

            local input = game:GetService("UserInputService")

            if input:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
            if input:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
            if input:IsKeyDown(Enum.KeyCode.A) then move = move - right end
            if input:IsKeyDown(Enum.KeyCode.D) then move = move + right end
            if input:IsKeyDown(Enum.KeyCode.Space) then move = move + up end
            if input:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - up end

            if move.Magnitude > 0 then
                move = move.Unit * FLY_SPEED
            end

            if flyBodyVelocity then
                flyBodyVelocity.Velocity = move
            end

            if flyGyro then
                local lookDirection = camCFrame.LookVector
                local targetCFrame = CFrame.new(rt.Position, rt.Position + lookDirection)
                flyGyro.CFrame = targetCFrame
            end
        end)
        
        player.CharacterAdded:Connect(function()
            if flyEnabled then
                local c2, h2, rt2 = getCharacter()
                if c2 and h2 and rt2 then
                    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
                    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
                    flyBodyVelocity = Instance.new("BodyVelocity")
                    flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                    flyBodyVelocity.Parent = rt2
                    flyGyro = Instance.new("BodyGyro")
                    flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                    flyGyro.Parent = rt2
                    h2.PlatformStand = true
                    if noclipEnabled then
                        applyNoclipToAllParts(true)
                    end
                end
            end
        end)
    else
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        local c, h = getCharacter()
        if h then h.PlatformStand = false end
        
        if not noclipEnabled then
            stopNoclipLoop()
            applyNoclipToAllParts(false)
        end
    end
end

function toggleGod()
    godEnabled = not godEnabled
    
    if godEnabled then
        if godHeartbeatConnection then godHeartbeatConnection:Disconnect() end
        if godCharacterConnection then godCharacterConnection:Disconnect() end
        
        local function applyGod()
            local c, h, r = getCharacter()
            if not c or not h or not r then return end
            h.MaxHealth = 9e9
            h.Health = 9e9
            h.BreakJointsOnDeath = false
            r.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end
        
        applyGod()
        
        godHeartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not godEnabled then return end
            local c, h, r = getCharacter()
            if not c or not h or not r then return end
            if h.Health <= 0 or h.Health < 1000 then
                h.Health = 9e9
            end
            if h.MaxHealth < 9e8 then
                h.MaxHealth = 9e9
            end
        end)
        
        godCharacterConnection = player.CharacterAdded:Connect(function()
            task.wait(0.1)
            if godEnabled then
                applyGod()
            end
        end)
        
    else
        if godHeartbeatConnection then godHeartbeatConnection:Disconnect(); godHeartbeatConnection = nil end
        if godCharacterConnection then godCharacterConnection:Disconnect(); godCharacterConnection = nil end
        
        local c, h, r = getCharacter()
        if c and h and r then
            h.MaxHealth = 100
            h.Health = 100
            h.BreakJointsOnDeath = true
            r.CustomPhysicalProperties = PhysicalProperties.new(1, 1, 1, 1, 1)
        end
    end
end

function toggleKillAura()
    killAuraEnabled = not killAuraEnabled
    if killAuraEnabled then
        if killAuraConnection then killAuraConnection:Disconnect() end
        killAuraConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not killAuraEnabled then return end
            local c, h, r = getCharacter()
            if not c or not h or not r then return end
            
            local nearest = nil
            local nearestDist = KILL_AURA_RANGE + 1
            for _, plr in ipairs(game.Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = plr.Character.HumanoidRootPart
                    local dist = (r.Position - targetRoot.Position).Magnitude
                    if dist < nearestDist and plr.Character.Humanoid.Health > 0 then
                        nearest = plr
                        nearestDist = dist
                    end
                end
            end
            if nearest then
                local targetRoot = nearest.Character.HumanoidRootPart
                local lookAt = (targetRoot.Position - r.Position).Unit
                r.CFrame = CFrame.new(r.Position, r.Position + lookAt)
                local tool = c:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("Handle") then
                    tool:Activate()
                    task.wait(KILL_AURA_DELAY)
                    tool:Deactivate()
                else
                    if targetRoot.Parent:FindFirstChild("Humanoid") then
                        targetRoot.Parent.Humanoid:TakeDamage(30)
                    end
                end
                task.wait(KILL_AURA_DELAY)
            end
        end)
    else
        if killAuraConnection then killAuraConnection:Disconnect(); killAuraConnection = nil end
    end
end

function toggleSpeed()
    speedEnabled = not speedEnabled
    local c, h, r = getCharacter()
    if not c or not h or not r then return end
    
    if speedEnabled then
        if speedHeartbeatConnection then speedHeartbeatConnection:Disconnect() end
        local origWalkSpeed = h.WalkSpeed
        h.WalkSpeed = SPEED_MULTIPLIER
        h.JumpPower = 100
        h.AutoRotate = true
        speedHeartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not speedEnabled then
                local c2, h2 = getCharacter()
                if h2 then
                    h2.WalkSpeed = origWalkSpeed
                    h2.JumpPower = 50
                end
                return
            end
            local c2, h2 = getCharacter()
            if h2 then
                h2.WalkSpeed = SPEED_MULTIPLIER
                h2.JumpPower = 100
            end
        end)
    else
        if speedHeartbeatConnection then speedHeartbeatConnection:Disconnect(); speedHeartbeatConnection = nil end
        local c2, h2 = getCharacter()
        if h2 then
            h2.WalkSpeed = 16
            h2.JumpPower = 50
        end
    end
end

function toggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        if espConnection then espConnection:Disconnect() end
        espConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if not espEnabled then return end
            for _, obj in ipairs(espObjects) do
                if obj then obj:Remove() end
            end
            espObjects = {}
            
            local c, h, r = getCharacter()
            if not c or not h or not r then return end
            
            for _, plr in ipairs(game.Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = plr.Character.HumanoidRootPart
                    local targetPos, onScreen = camera:WorldToViewportPoint(targetRoot.Position)
                    if onScreen then
                        local dist = (r.Position - targetRoot.Position).Magnitude
                        local health = plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health or 0
                        local healthPercent = math.clamp(health / 100, 0, 1)
                        
                        local box = Drawing.new("Square")
                        box.Size = Vector2.new(60, 80)
                        box.Position = Vector2.new(targetPos.X - 30, targetPos.Y - 40)
                        box.Thickness = 2
                        box.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                        box.Transparency = 0.7
                        box.Filled = false
                        box.Visible = true
                        table.insert(espObjects, box)
                        
                        local nameTag = Drawing.new("Text")
                        nameTag.Position = Vector2.new(targetPos.X, targetPos.Y - 50)
                        nameTag.Text = plr.Name .. " | " .. math.floor(dist) .. "m"
                        nameTag.Size = 16
                        nameTag.Color = Color3.fromRGB(255, 255, 255)
                        nameTag.Center = true
                        nameTag.Visible = true
                        table.insert(espObjects, nameTag)
                        
                        local healthBar = Drawing.new("Line")
                        healthBar.From = Vector2.new(targetPos.X - 30, targetPos.Y + 40)
                        healthBar.To = Vector2.new(targetPos.X - 30 + (60 * healthPercent), targetPos.Y + 40)
                        healthBar.Thickness = 4
                        healthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                        healthBar.Visible = true
                        table.insert(espObjects, healthBar)
                    end
                end
            end
        end)
    else
        if espConnection then espConnection:Disconnect(); espConnection = nil end
        for _, obj in ipairs(espObjects) do
            if obj then obj:Remove() end
        end
        espObjects = {}
    end
end

local function getPlayersList()
    local players = {}
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(players, plr)
        end
    end
    return players
end

